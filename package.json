{
  "name": "@wiseranye/bubble-code",
  "version": "0.1.0",
  "description": "Bubble Code - 一个编码智能体",
  "license": "MIT",
  "bin": {
    "bubble": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "check": "biome check",
    "dev": "tsc --watch",
    "test": "biome check && npm run build && ava",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "chalk": "^5.2.0",
    "execa": "^10.0.1",
    "jsonc-parser": "^3.3.1",
    "meow": "^11.0.0",
    "openai": "^7.15.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@biomejs/biome": "2.5.15",
    "@sindresorhus/tsconfig": "^3.0.1",
    "@types/node": "^26.6.4",
    "ava": "^6.4.1",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.9.0"
  },
  "ava": {
    "typescript": {
      "extensions": [
        "ts"
      ],
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    }
  }
}
