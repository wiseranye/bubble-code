{
  "name": "@wiseranye/bubble-code",
  "version": "0.2.0-beta.1",
  "description": "Bubble Code - 一个编码智能体",
  "license": "MIT",
  "bin": {
    "bubble": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wiseranye/bubble-code.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "check": "tsc --noEmit && biome check",
    "check:watch": "tsc --noEmit --watch",
    "test": "npm run check && npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^5.6.2",
    "execa": "^10.2.0",
    "jsonc-parser": "^3.3.1",
    "meow": "^11.0.0",
    "shiki": "^4.5.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/node": "^26.6.5",
    "tsc-alias": "^1.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
