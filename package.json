{
  "name": "@wiseranye/bubble-code",
  "version": "0.1.0",
  "description": "Bubble Code - 一个编码智能体",
  "license": "MIT",
  "bin": {
    "bubble": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "dev": "tsc --watch",
    "test": "prettier --check . && xo && npm run build && ava",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "chalk": "^5.2.0",
    "execa": "^10.0.1",
    "jsonc-parser": "^3.3.1",
    "meow": "^11.0.0",
    "openai": "^7.15.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@sindresorhus/tsconfig": "^3.0.1",
    "@vdemedes/prettier-config": "^2.0.1",
    "ava": "^6.4.1",
    "prettier": "^2.8.7",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.9.0",
    "xo": "^0.53.1"
  },
  "ava": {
    "typescript": {
      "extensions": [
        "ts"
      ],
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    }
  }
}
