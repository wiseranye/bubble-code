{
  "name": "@wiseranye/bubble-code",
  "version": "0.1.0",
  "description": "Bubble Code - 一个编码智能体",
  "license": "MIT",
  "bin": {
    "bubble": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check": "tsc --noEmit && biome check",
    "test": "npm run check && npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "chalk": "^5.2.0",
    "execa": "^10.0.1",
    "jsonc-parser": "^3.3.1",
    "meow": "^11.0.0",
    "openai": "^7.15.0",
    "shiki": "^4.4.3",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/node": "^26.6.4",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
