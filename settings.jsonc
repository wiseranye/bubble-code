{
  // 输入框上方的状态栏；style: default | nerdfont | powerline
  "statusBar": {
    "enable": true,
    "style": "nerdfont"
  },
  "providers": [
    {
      "name": "deepseek",
      "type": "openai-completions",
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "",
      // 命中 pi-ai builtin catalog 的模型只需写 id，元数据自动带出来；
      // 其余字段（reasoning/input/maxTokens/contextWindow）写了则覆盖 catalog
      "models": [{ "id": "deepseek-flash" }]
    }
  ]
}
